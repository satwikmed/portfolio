{
  "name": "satwik-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "dev:turbo": "next dev --turbo -p 3001",
    "dev:webpack": "next dev -p 3001",
    "dev:stable": "npm run build && next start -p 3001",
    "dev:clean": "lsof -ti :3000 -ti :3001 | xargs kill -9 2>/dev/null; sleep 0.5; rm -rf .next && next dev -p 3001",
    "fix": "lsof -ti :3000 -ti :3001 | xargs kill -9 2>/dev/null; sleep 0.5; rm -rf .next",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "screenshots": "node scripts/capture-screenshots.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "canvas-confetti": "^1.9.4",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.469.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.1.0",
    "playwright": "^1.61.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
